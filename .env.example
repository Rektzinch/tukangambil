# Optional provider endpoints (https only)
COBALT_API_URL=
COBALT_API_URLS=
# Optional Cobalt authentication
COBALT_API_KEY=
COBALT_AUTH_SCHEME=Api-Key
# Netscape cookies (Base64) for content requiring a session. Do not use a main account.
YTDLP_COOKIES_B64=
# PINNED builds: YTDLP_BINARY_SHA256 is REQUIRED whenever YTDLP_BINARY_URL is set.
YTDLP_BINARY_URL=https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux
YTDLP_BINARY_SHA256=
# Required to enable signed download tokens (safe cross-origin downloads).
DOWNLOAD_TOKEN_SECRET=
# Max download size in bytes (default 1 GiB; naikkan untuk 4K/super HD).
MAX_DOWNLOAD_BYTES=
# Optional production origin.
PUBLIC_ORIGIN=
