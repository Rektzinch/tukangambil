{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/extract.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/youtube-dl-exec/bin/**"
    },
    "api/download.js": {
      "maxDuration": 60
    },
    "api/health.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
