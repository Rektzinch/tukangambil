# Optional provider endpoints (https only)
COBALT_API_URL=
COBALT_API_URLS=
# Optional Cobalt authentication
COBALT_API_KEY=
COBALT_AUTH_SCHEME=Api-Key
# Netscape cookies (Base64) for content requiring a session. Do not use a main account.
YTDLP_COOKIES_B64=
# PINNED builds (reproducible): set BOTH YTDLP_BINARY_URL and YTDLP_BINARY_SHA256.
# If only one is set, install fails. Leave both empty to use 'latest' (with a warning).
YTDLP_BINARY_URL=
YTDLP_BINARY_SHA256=
# Optional: enables short-lived HMAC download tokens. Without it, browser-initiated same-origin requests remain supported.
DOWNLOAD_TOKEN_SECRET=
# Max download size in bytes (default 1 GiB; naikkan untuk 4K/super HD).
MAX_DOWNLOAD_BYTES=
# Optional production origin.
PUBLIC_ORIGIN=
# Optional persistent rate-limit backend (Upstash Redis REST). When both are set,
# rate limiting is enforced across serverless instances; otherwise in-memory
# (best-effort per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional fastdl Instagram provider (own backend). When FASTDL_API_KEY is set,
# Instagram post/reel/story/profile requests are also served via your fastdl
# worker hub. Header name for the key is configurable (default x-api-key).
FASTDL_API_URL=https://api-wh.fastdl.app
FASTDL_API_KEY=
FASTDL_API_KEY_HEADER=x-api-key
FASTDL_MEDIA_URL=https://media.fastdl.app
# Alternative to FASTDL_API_KEY for an operator-managed FastDL web-signing flow.
# Never commit either value; both are required together when this route is used.
FASTDL_WEB_SIGNATURE_SECRET=
FASTDL_WEB_SIGNATURE_TIMESTAMP=
